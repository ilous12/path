{
  "dependencies": {
    "next": "16.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "husky": "^9.1.7",
    "turbo": "^2.8.12"
  },
  "name": "path",
  "packageManager": "pnpm@10.33.4",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "dev": "pnpm --filter www dev --hostname localhost --port 3100",
    "format": "biome format --write .",
    "lint": "turbo run lint --",
    "prepare": "husky",
    "release": "changeset publish",
    "version-packages": "changeset version",
    "typecheck": "pnpm --filter www exec next typegen && pnpm --filter www exec tsc --noEmit",
    "start": "pnpm --filter www start --hostname localhost --port 3100"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
